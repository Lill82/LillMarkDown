<Window x:Class="LillMarkDown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LillMarkDown"
        Icon="LillMarkDown.ico"
        Height="500" Width="560"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- Títol -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="Lill" FontSize="22" FontWeight="Light" Foreground="#5A6473"/>
            <TextBlock Text="MarkDown" FontSize="22" FontWeight="Bold" Foreground="#1A73E8"/>
        </StackPanel>

        <!-- Zona d'arrossegament -->
        <Grid Grid.Row="1"
              x:Name="DropZoneGrid"
              AllowDrop="True"
              Cursor="Hand"
              Drop="DropZone_Drop"
              DragEnter="DropZone_DragEnter"
              DragLeave="DropZone_DragLeave"
              DragOver="DropZone_DragOver"
              MouseLeftButtonDown="DropZone_Click">

            <Rectangle x:Name="DropZoneRect"
                       Stroke="#B0C4DE"
                       StrokeThickness="2"
                       StrokeDashArray="6 3"
                       Fill="#FAFCFF"
                       RadiusX="10" RadiusY="10"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Border Background="#E8F0FE" CornerRadius="8"
                        Padding="16,10" HorizontalAlignment="Center">
                    <TextBlock Text="PDF" FontSize="28" FontWeight="Bold"
                               Foreground="#1A73E8" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Arrossega fitxers PDF aquí"
                           FontSize="16" FontWeight="Medium"
                           Foreground="#3C4043"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,4"/>
                <TextBlock Text="o fes clic per cercar"
                           FontSize="12"
                           Foreground="#80868B"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Estat -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Text="A punt — arrossega un PDF per començar."
                   Foreground="#80868B"
                   FontSize="12"
                   Margin="0,10,0,6"/>

        <!-- Registre -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="6"
                BorderBrush="#DDE1E7"
                BorderThickness="1">
            <ScrollViewer x:Name="LogScroller"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0">
                <TextBlock x:Name="LogText"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#5A6473"
                           Padding="10,8"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
